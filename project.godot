; Kings of Egypt City - Godot 4.7+
config_version=5

[application]
config/name="KING OF EGYPT CITY"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="مشروع مدينة ثلاثية الأبعاد قابل للتطوير"

[autoload]
CityLanguage="*res://scripts/city_language.gd"

[display]
